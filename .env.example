# Mail provider configuration
MAIL_PROVIDER=graph

# Microsoft Graph Mail Settings
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=your-client-secret-here
GRAPH_SENDER_USER=quotation-app@your-company.co.jp

# Optional SMTP Fallback Settings
# Only needed if MAIL_PROVIDER=smtp
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
